@host = http://localhost:3000
@key = local-dev-key

### 1) Direct call: SFCC event envelope as JSON (what int_google_pubsub builds)
POST {{host}}/sfcc/customers
content-type: application/json
x-api-key: {{key}}

{
  "eventType": "dropshipper.account.created",
  "eventVersion": "1.0",
  "occurredAt": "2026-11-05T10:00:00Z",
  "source": "sfcc",
  "correlationId": "b2c3d4e5-f6a7-4901-8cde-f12345678901",
  "idempotencyKey": "sfcc-00012345-dropshipper.account.created",
  "payload": {
    "customer__customer-no": "00012345",
    "customer__profile__first-name": "Jane",
    "customer__profile__last-name": "Doe",
    "customer_profile_email": "jane.doe@example.com",
    "customer_addresses_address_phone": "+31612345678",
    "customer_addresses_address_company-name": "Jane BV",
    "Customer_addresses_address_country-code": "NL",
    "country__code": "NL",
    "customer_addresses_address_address1": "Main street 1",
    "customer_addresses_address_address2": "",
    "customer_addresses_address_postal-code": "1011AB",
    "customer_addresses_address_city": "Amsterdam",
    "customer__addresses__address__state-code": "",
    "customer_addresses_address_region": "",
    "customer_addresses_address_district": "",
    "vat": "NL123456789B01",
    "Language": "nl",
    "sapDebtorId": "",
    "sapCustomerNo": ""
  }
}

### 2) Pub/Sub push style: same envelope, base64 in message.data
# data = base64 of the envelope above (any valid envelope works)
POST {{host}}/pubsub/push
content-type: application/json

{
  "message": {
    "data": "",
    "messageId": "1234567890"
  },
  "subscription": "projects/demo/subscriptions/demo-sub"
}

### List stored customers
GET {{host}}/customers
x-api-key: {{key}}

### Look up by email
GET {{host}}/customers?email=jane.doe@example.com
x-api-key: {{key}}
